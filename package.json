{
  "name": "my-backend-service",
  "version": "1.0.0",
  "description": "Node.js and TypeScript backend",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "rm -rf dist && tsc",
    "start": "node dist/index.js",
    "lint": "eslint . --ext .ts",
    "type-check": "tsc --noEmit",
    "worker:transcribe": "tsx src/workers/transcribe.worker.ts",
    "worker:render": "tsx src/workers/render.worker.ts",
    "worker:keyword": "tsx src/workers/keyword-extraction.worker.ts",
    "worker:broll": "tsx src/workers/broll.worker.ts",
    "worker:crop": "tsx src/workers/crop.worker.ts",
    "worker:all": "concurrently \"tsx src/workers/transcribe.worker.ts\" \"tsx src/workers/render.worker.ts\" \"tsx src/workers/keyword-extraction.worker.ts\" \"tsx src/workers/broll.worker.ts\" \"tsx src/workers/crop.worker.ts\"",
    "dev:all": "concurrently \"tsx watch src/index.ts\" \"tsx watch src/workers/transcribe.worker.ts\" \"tsx watch src/workers/render.worker.ts\" \"tsx watch src/workers/keyword-extraction.worker.ts\" \"tsx watch src/workers/broll.worker.ts\" \"tsx watch src/workers/crop.worker.ts\""
  },
  "dependencies": {
    "@bull-board/api": "^7.2.1",
    "@bull-board/express": "^7.2.1",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bullmq": "^5.76.10",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ioredis": "^5.10.1",
    "minio": "^8.0.7",
    "openai": "^6.45.0",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prisma": "^7.8.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "@types/pg": "^8.20.0",
    "concurrently": "^10.0.3",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5"
  }
}
