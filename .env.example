MINIO_ENDPOINT=**(string)
MINIO_PORT=**(number)
MINIO_ACCESS_KEY=**(string)
MINIO_SECRET_KEY=**(string)

REDIS_HOST=**(string)
REDIS_PORT= **(number)

DATABASE_URL=postgresql://**:**@**:**/**/** (string)

PORT= **(number)
NODE_ENV= **(production, development, test) (string)

JOB_WEBHOOK_URL= (optional absolute URL; empty = no global default)
JOB_WEBHOOK_TIMEOUT_MS=5000

# Media binaries (optional). Leave unset to use vendored ffmpeg-static /
# ffprobe-static (libass-enabled, required for subtitle burn-in).
# FFMPEG_PATH=
# FFPROBE_PATH=

# Fonts for subtitle burn-in (libass fontsdir). Default is macOS Arial location.
# On Linux set to a dir that contains your FontName file, e.g. /usr/share/fonts/truetype/dejavu
# SUBTITLE_FONTS_DIR=/System/Library/Fonts/Supplemental
# SUBTITLE_FONT_NAME=Arial
