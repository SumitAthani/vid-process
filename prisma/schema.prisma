// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum JobStatus {
  queued
  processing
  completed
  failed
}

model Job {
  id                String    @id @default(uuid()) @db.Uuid
  objectName        String    @map("object_name")
  status            JobStatus @default(queued)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at")
  transcriptJsonKey String?   @map("transcript_json_key")
  transcriptTextKey String?   @map("transcript_text_key")
  subtitlesSrtKey   String?   @map("subtitles_srt_key")
  subtitlesVttKey   String?   @map("subtitles_vtt_key")

  @@map("jobs")
}
