// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum JobStatus {
  queued
  processing
  completed
  failed
}

enum StepStatus {
  to_be_queued
  queued
  processing
  completed
  failed
}

enum CropStrategy {
  center
  pad
}

enum PadBackground {
  black
  white
  blur
}

model Job {
  id         String    @id @default(uuid()) @db.Uuid
  objectName String    @map("object_name")
  status     JobStatus @default(queued)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at")

  // transription extraction keys
  transcriptJsonKey String? @map("transcript_json_key")
  transcriptTextKey String? @map("transcript_text_key")
  subtitlesSrtKey   String? @map("subtitles_srt_key")
  subtitlesVttKey   String? @map("subtitles_vtt_key")

  // add any message to showcase whats happening / just tell the step name
  currentStep String? @map("current_step")

  transcriptionStatus StepStatus @default(to_be_queued) @map("transcription_status")
  transcriptionError  String?    @map("transcription_error")

  // keyword extraction keys
  brollManifestKey        String?    @map("broll_manifest_key")
  keywordExtractionStatus StepStatus @default(to_be_queued) @map("keyword_extraction_status")
  keywordExtractionError  String?    @map("keyword_extraction_error")

  // broll
  brollStatus      StepStatus? @default(to_be_queued) @map("broll_status")
  brollError       String?     @map("broll_error")
  brollResolvedKey String?     @map("broll_resolved_key")

  // primary video crop (9:16)
  cropStatus       StepStatus    @default(to_be_queued) @map("crop_status")
  cropError        String?       @map("crop_error")
  croppedVideoKey  String?       @map("cropped_video_key")
  cropStrategy     CropStrategy  @default(center) @map("crop_strategy")
  padBackground    PadBackground? @map("pad_background")

  // layout composition (B-roll overlays)
  layoutVideoKey String? @map("layout_video_key")
  // optional job-wide B-roll layout override ("top-half-overlay" | "half-and-half")
  brollLayout    String? @map("broll_layout")

  // final reel with burned-in subtitles
  finalVideoKey String? @map("final_video_key")

  // subtitle burn-in style (resolved at job create from body + env defaults)
  subtitleFontSize Int    @default(48) @map("subtitle_font_size")
  subtitleMarginV  Int    @default(360) @map("subtitle_margin_v")
  subtitleMarginL  Int    @default(80) @map("subtitle_margin_l")
  subtitleMarginR  Int    @default(140) @map("subtitle_margin_r")
  subtitleFontName String @default("Arial") @map("subtitle_font_name")

  // outbound completion webhook (per-job URL; falls back to JOB_WEBHOOK_URL env)
  webhookUrl    String?   @map("webhook_url")
  webhookSentAt DateTime? @map("webhook_sent_at")

  @@map("jobs")
}
